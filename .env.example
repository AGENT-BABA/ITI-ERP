# ──────────────────────────────────────────────
# ITI ERP System — Environment Variables
# Copy to .env and fill in real values
# ──────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────
POSTGRES_DB=iti_erp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── API ───────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# JWT (Secret must be >= 32 chars)
JwtSettings__Secret=CHANGE_ME_MIN_32_CHARS_SECRET_KEY_HERE
JwtSettings__Issuer=ITI.ERP.Api
JwtSettings__Audience=ITI.ERP.Client
JwtSettings__ExpiryInMinutes=15
JwtSettings__RefreshTokenExpiryInDays=7

# ── Connection String (built from PG vars) ────
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=iti_erp;Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}

# ── Seed Admin Credentials ────────────────────
SeedAdmin__Username=admin
SeedAdmin__Password=Admin@123
SeedAdmin__Email=admin@satana.edu

# ── File Storage ──────────────────────────────
FileStorage__Provider=Local
FileStorage__LocalBasePath=/data/files
FileStorage__LocalBaseUrl=https://your-domain.com/files

# ── Frontend ──────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000/api/v1

# ── CORS (comma-separated origins) ───────────
AllowedOrigins__0=https://your-domain.com
