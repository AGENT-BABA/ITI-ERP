{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=iti_erp;Username=postgres;Password=Agent#007"
  },
  "JwtSettings": {
    "Secret": "DEVELOPMENT_SECRET_MIN_32_CHARS_LONG_REPLACE_IN_PROD!",
    "Issuer": "ITI.ERP.Api",
    "Audience": "ITI.ERP.Client",
    "ExpiryInMinutes": 15,
    "RefreshTokenExpiryInDays": 7
  },
  "FileStorage": {
    "Provider": "Local",
    "LocalBasePath": "C:\\ITI ERP\\FileStorage",
    "LocalBaseUrl": "https://localhost:5001/files"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/erp-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ]
  },
  "AllowedOrigins": [
    "https://localhost:3000",
    "http://localhost:3000",
    "https://localhost:4200",
    "http://localhost:4200"
  ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Email": {
    "Provider": "Console",
    "FrontendBaseUrl": "http://localhost:3000"
  }
}
